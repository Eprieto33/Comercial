/* ============================================================ HISTORIAL */
function HistorialTab({ branch, branchName, currentDate, onSelectDate }) {
  const [dates, setDates] = useState(null);

  useEffect(() => {
    let cancelled = false;
    setDates(null);
    (async () => {
      try {
        const res = await window.storage.list(`corte:${branch}:`, true);
        const keys = (res && res.keys) || [];
        const ds = keys.map((k) => k.split(":")[2]).filter(Boolean).sort().reverse();
        if (!cancelled) setDates(ds);
      } catch (e) {
        if (!cancelled) setDates([]);
      }
    })();
    return () => { cancelled = true; };
  }, [branch]);

  return (
    <div className="panel">
      <div className="panel-head">
        <div><h2>Historial — {branchName}</h2><p className="muted">Toca una fecha para abrirla en Resumen.</p></div>
      </div>
      {!dates ? (
        <div className="loading">Cargando historial…</div>
      ) : dates.length === 0 ? (
        <div className="empty">Todavía no hay cortes guardados para esta sucursal.</div>
      ) : (
        <div className="history-list">
          {dates.map((d) => (
            <button key={d} className={"history-item" + (d === currentDate ? " active" : "")} onClick={() => onSelectDate(d)}>{d}</button>
          ))}
        </div>
      )}
    </div>
  );
}

