/* ============================================================ COMPARATIVO */
function ComparativoTab({ branches, date }) {
  const [rows, setRows] = useState(null);

  useEffect(() => {
    let cancelled = false;
    setRows(null);
    (async () => {
      const results = await Promise.all(
        branches.map(async (b) => {
          const data = await getJSON(storageKey(b.code, date), null);
          if (!data) return { ...b, total: 0, efectivo: 0, tickets: 0, diff: 0, hasData: false };
          let total = 0, efectivo = 0;
          (data.transactions || []).forEach((row) => {
            PAY_FIELDS.forEach((f) => (total += Number(row[f.key]) || 0));
            efectivo += Number(row.efectivo) || 0;
          });
          const parcialesTotal = (data.parciales || []).reduce((s, p) => s + (Number(p.monto) || 0), 0);
          return { ...b, total, efectivo, tickets: (data.transactions || []).length, diff: efectivo - parcialesTotal, hasData: true };
        })
      );
      if (!cancelled) setRows(results);
    })();
    return () => { cancelled = true; };
  }, [branches, date]);

  const grandTotal = rows ? rows.reduce((s, r) => s + r.total, 0) : 0;

  return (
    <div className="panel">
      <div className="panel-head">
        <div><h2>Comparativo por sucursal</h2><p className="muted">{date}</p></div>
        <div className="card compact"><div className="card-label">Total todas las sucursales</div><div className="card-value">{money(grandTotal)}</div></div>
      </div>
      {!rows ? (
        <div className="loading">Cargando sucursales…</div>
      ) : (
        <table className="method-table">
          <thead><tr><th>Sucursal</th><th>Tickets</th><th>Efectivo</th><th>Total</th><th>Dif. flujo</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr key={r.code} className={!r.hasData ? "muted-row" : ""}>
                <td>{r.code} · {r.name}</td><td>{r.tickets}</td><td>{money(r.efectivo)}</td><td>{money(r.total)}</td>
                <td className={r.hasData && Math.abs(r.diff) > 0.01 ? "bad-text" : ""}>{r.hasData ? money(r.diff) : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  );
}

