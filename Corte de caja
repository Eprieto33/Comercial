.tablero-scroll{ overflow-x:auto; border:1px solid var(--line); border-radius:12px; background:var(--surface); margin-bottom:20px; }
.tablero-table{ border-collapse:collapse; width:100%; font-size:12px; }
.tablero-table th, .tablero-table td{ padding:7px 10px; border-bottom:1px solid var(--line); border-right:1px solid var(--line); white-space:nowrap; }
.tablero-table th{ background:#FBF9F4; font-size:10px; text-transform:uppercase; letter-spacing:.03em; color:var(--ink-soft); position:sticky; top:0; }
.tablero-table tfoot td{ font-weight:700; background:var(--accent-soft); border-top:2px solid var(--accent); }
.tablero-table .mono{ font-family:var(--mono); }
.tablero-table .strong{ font-weight:700; }
.tablero-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; }
@media (max-width:820px){ .tablero-grid{ grid-template-columns:1fr; } }

.history-list{ display:flex; flex-direction:column; gap:6px; }
.history-item{ text-align:left; padding:12px 16px; border:1px solid var(--line); border-radius:10px; background:var(--surface); font-family:var(--mono); font-size:14px; cursor:pointer; color:var(--ink); }
.history-item.active{ border-color:var(--accent); background:var(--accent-soft); }
.history-item:hover{ border-color:var(--accent); }

.foot{ text-align:center; font-size:11px; color:var(--ink-soft); padding:20px; max-width:600px; margin:0 auto; }
`;
