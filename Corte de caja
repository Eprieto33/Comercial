# Comercial
import React, { useState, useEffect, useMemo, useRef } from "react";

/* ============================================================
   CORTE DE CAJA — plataforma multi-sucursal
   ============================================================ */

const FONT_LINK_ID = "corte-caja-fonts";
function ensureFonts() {
  if (document.getElementById(FONT_LINK_ID)) return;
  const link = document.createElement("link");
  link.id = FONT_LINK_ID;
  link.rel = "stylesheet";
  link.href =
    "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap";
  document.head.appendChild(link);
}

const DEFAULT_BRANCHES = [
  { code: "DACA", name: "Acapulco" },
  { code: "DAGU", name: "Aguascalientes" },
  { code: "DCAN", name: "Cancún" },
  { code: "DDF", name: "CDMX" },
  { code: "DHER", name: "Hermosillo" },
  { code: "DMOR", name: "Morelia" },
  { code: "DPAZ", name: "La Paz" },
  { code: "DREY", name: "Monterrey" },
  { code: "DSLP", name: "San Luis Potosí" },
  { code: "DTEP", name: "Tepic" },
  { code: "DTIJ", name: "Tijuana" },
  { code: "DTOR", name: "Torreón" },
];

const PAY_FIELDS = [
  { key: "efectivo", label: "Efectivo", short: "Efvo" },
  { key: "transfer", label: "Transferencia", short: "Transf" },
  { key: "depositos", label: "Depósitos", short: "Depó" },
  { key: "pcpay", label: "PC PAY", short: "PCPay" },
  { key: "cdp", label: "Central de Pagos", short: "CdP" },
  { key: "cdpAmex", label: "CDP AMEX", short: "CdPAmx" },
  { key: "amex", label: "AMEX", short: "Amex" },
  { key: "anticipo", label: "Anticipo", short: "Antic" },
  { key: "credito", label: "Crédito", short: "Créd" },
  { key: "notaCredito", label: "Nota Crédito", short: "N.Créd" },
];

const money = (n) =>
  (Number(n) || 0).toLocaleString("es-MX", {
    style: "currency",
    currency: "MXN",
    minimumFractionDigits: 2,
  });
const num = (n) => (Number(n) || 0).toLocaleString("es-MX", { maximumFractionDigits: 2 });
const todayISO = () => new Date().toISOString().slice(0, 10);

const emptyTransaction = () => ({
  id: "t" + Math.random().toString(36).slice(2, 10),
  persona: "",
  ticket: "TVI",
  pzas: "",
  envios: "",
  efectivo: "",
  transfer: "",
  depositos: "",
  pcpay: "",
  cdp: "",
  cdpAmex: "",
  amex: "",
  anticipo: "",
  credito: "",
  notaCredito: "",
});

const emptyParcial = () => ({
  id: "p" + Math.random().toString(36).slice(2, 10),
  depositId: "",
  monto: "",
  locked: false,
});

const emptyCorte = () => ({
  piezasSAP: "",
  fondoFijo: "2827",
  saldoDiaAnterior: "0",
  transactions: [],
  parciales: [],
  updatedAt: null,
});

const storageKey = (branch, date) => `corte:${branch}:${date}`;

async function getJSON(key, fallback) {
  try {
    const res = await window.storage.get(key, true);
    if (!res) return fallback;
    return JSON.parse(res.value);
  } catch (e) {
    return fallback;
  }
}
async function setJSON(key, value) {
  try {
    await window.storage.set(key, JSON.stringify(value), true);
    return true;
  } catch (e) {
    return false;
  }
}

/* ============================================================ */

export default function App() {
  useEffect(ensureFonts, []);

  const [branches, setBranches] = useState(DEFAULT_BRANCHES);
  const [branch, setBranch] = useState(DEFAULT_BRANCHES[0].code);
  const [date, setDate] = useState(todayISO());
  const [corte, setCorte] = useState(emptyCorte());
  const [cajeros, setCajeros] = useState([]);
  const [tab, setTab] = useState("registrar");
  const [loading, setLoading] = useState(true);
  const [saveState, setSaveState] = useState("idle");
  const [showAddBranch, setShowAddBranch] = useState(false);
  const [newBranchCode, setNewBranchCode] = useState("");
  const [newBranchName, setNewBranchName] = useState("");
  const [error, setError] = useState("");
  const saveTimer = useRef(null);
  const firstLoad = useRef(true);

  useEffect(() => {
    (async () => {
      const savedBranches = await getJSON("config:branches", null);
      if (savedBranches && savedBranches.length) {
        setBranches(savedBranches);
        setBranch(savedBranches[0].code);
      } else {
        await setJSON("config:branches", DEFAULT_BRANCHES);
      }
      const savedCajeros = await getJSON("config:cajeros", null);
      setCajeros(savedCajeros || []);
    })();
  }, []);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    firstLoad.current = true;
    (async () => {
      const data = await getJSON(storageKey(branch, date), emptyCorte());
      if (!cancelled) {
        setCorte({ ...emptyCorte(), ...data });
        setLoading(false);
        setTimeout(() => (firstLoad.current = false), 50);
      }
    })();
    return () => {
      cancelled = true;
    };
  }, [branch, date]);

  useEffect(() => {
    if (loading || firstLoad.current) return;
    setSaveState("saving");
    if (saveTimer.current) clearTimeout(saveTimer.current);
    saveTimer.current = setTimeout(async () => {
      const ok = await setJSON(storageKey(branch, date), { ...corte, updatedAt: new Date().toISOString() });
      setSaveState(ok ? "saved" : "idle");
    }, 600);
    return () => clearTimeout(saveTimer.current);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [corte]);

  const totals = useMemo(() => {
    const t = {};
    PAY_FIELDS.forEach((f) => (t[f.key] = 0));
    let pzas = 0,
      envios = 0,
      count = 0;
    corte.transactions.forEach((row) => {
      count++;
      pzas += Number(row.pzas) || 0;
      envios += Number(row.envios) || 0;
      PAY_FIELDS.forEach((f) => (t[f.key] += Number(row[f.key]) || 0));
    });
    const grandTotal = PAY_FIELDS.reduce((s, f) => s + t[f.key], 0);
    return { byMethod: t, pzas, envios, totalPzas: pzas, grandTotal, count };
  }, [corte.transactions]);

  const parcialesTotal = useMemo(
    () => corte.parciales.reduce((s, p) => s + (Number(p.monto) || 0), 0),
    [corte.parciales]
  );

  const piezasSAP = Number(corte.piezasSAP) || 0;
  const diferenciaPiezas = piezasSAP - totals.totalPzas;
  const efectivoTotal = totals.byMethod.efectivo;
  const diferenciaFlujoEfectivo = efectivoTotal - parcialesTotal;
  const saldoDiaAnterior = Number(corte.saldoDiaAnterior) || 0;
  const totalSaldos = diferenciaFlujoEfectivo + saldoDiaAnterior;
  const fondoFijo = Number(corte.fondoFijo) || 0;
  const aperturaSiguienteDia = totalSaldos + fondoFijo;
  const balanceado = Math.abs(diferenciaFlujoEfectivo) < 0.01;

  const updateField = (key, value) => setCorte((c) => ({ ...c, [key]: value }));

  const addTransaction = () =>
    setCorte((c) => ({ ...c, transactions: [...c.transactions, emptyTransaction()] }));

  const updateTransaction = (id, field, value) =>
    setCorte((c) => ({
      ...c,
      transactions: c.transactions.map((r) => (r.id === id ? { ...r, [field]: value } : r)),
    }));

  const setPersona = (id, name) => {
    const cajero = cajeros.find((c) => c.name === name);
    setCorte((c) => ({
      ...c,
      transactions: c.transactions.map((r) =>
        r.id === id
          ? { ...r, persona: name, efectivo: cajero?.efectivoBloqueado ? "" : r.efectivo }
          : r
      ),
    }));
  };

  const deleteTransaction = (id) =>
    setCorte((c) => ({ ...c, transactions: c.transactions.filter((r) => r.id !== id) }));

  const registrarParcial = (depositId, monto) =>
    setCorte((c) => ({
      ...c,
      parciales: [...c.parciales, { ...emptyParcial(), depositId, monto, locked: true }],
    }));

  const addBranch = async () => {
    const code = newBranchCode.trim().toUpperCase();
    const name = newBranchName.trim();
    if (!code || !name) return setError("Escribe código y nombre de la sucursal.");
    if (branches.some((b) => b.code === code)) return setError("Ese código ya existe.");
    const list = [...branches, { code, name }];
    setBranches(list);
    await setJSON("config:branches", list);
    setBranch(code);
    setNewBranchCode("");
    setNewBranchName("");
    setShowAddBranch(false);
    setError("");
  };

  const addCajero = async (name, efectivoBloqueado) => {
    const clean = name.trim();
    if (!clean) return;
    if (cajeros.some((c) => c.name.toLowerCase() === clean.toLowerCase())) return;
    const list = [...cajeros, { id: "c" + Math.random().toString(36).slice(2, 9), name: clean, efectivoBloqueado }];
    setCajeros(list);
    await setJSON("config:cajeros", list);
  };

  const toggleCajeroLock = async (id) => {
    const list = cajeros.map((c) => (c.id === id ? { ...c, efectivoBloqueado: !c.efectivoBloqueado } : c));
    setCajeros(list);
    await setJSON("config:cajeros", list);
  };

  const deleteCajero = async (id) => {
    const list = cajeros.filter((c) => c.id !== id);
    setCajeros(list);
    await setJSON("config:cajeros", list);
  };

  const branchName = branches.find((b) => b.code === branch)?.name || branch;
  const usedTickets = corte.transactions.map((t) => t.ticket);

  return (
    <div className="app">
      <style>{CSS}</style>

      <header className="topbar">
        <div className="brand">
          <div className="brand-mark">CC</div>
          <div>
            <div className="brand-title">Corte de Caja</div>
            <div className="brand-sub">Registro diario · {branches.length} sucursales</div>
          </div>
        </div>

        <div className="selectors">
          <label className="sel">
            <span>Sucursal</span>
            <select value={branch} onChange={(e) => setBranch(e.target.value)}>
              {branches.map((b) => (
                <option key={b.code} value={b.code}>
                  {b.code} · {b.name}
                </option>
              ))}
            </select>
          </label>
          <button className="ghost-btn small" onClick={() => setShowAddBranch((v) => !v)}>
            + sucursal
          </button>
          <label className="sel">
            <span>Fecha</span>
            <input type="date" value={date} onChange={(e) => setDate(e.target.value)} />
          </label>
          <div className={"save-chip " + saveState}>
            {saveState === "saving" ? "Guardando…" : saveState === "saved" ? "Guardado ✓" : "—"}
          </div>
        </div>
      </header>

      {showAddBranch && (
        <div className="add-branch-panel">
          <input placeholder="Código (ej. DQRO)" value={newBranchCode} onChange={(e) => setNewBranchCode(e.target.value)} />
          <input placeholder="Nombre (ej. Querétaro)" value={newBranchName} onChange={(e) => setNewBranchName(e.target.value)} />
          <button className="primary-btn small" onClick={addBranch}>Agregar</button>
          {error && <span className="error-text">{error}</span>}
        </div>
      )}

      <nav className="tabs">
        {[
          ["registrar", "Registrar ventas"],
          ["resumen", "Resumen y conciliación"],
          ["parciales", "Depósitos / Brinks"],
          ["tablero", "Tablero"],
          ["comparativo", "Comparativo sucursales"],
          ["cajeros", "Cajeros"],
          ["historial", "Historial"],
        ].map(([key, label]) => (
          <button key={key} className={"tab" + (tab === key ? " active" : "")} onClick={() => setTab(key)}>
            {label}
          </button>
        ))}
      </nav>

      <main className="content">
        {loading ? (
          <div className="loading">Cargando corte de {branchName}…</div>
        ) : (
          <>
            {tab === "registrar" && (
              <RegistrarTab
                corte={corte}
                totals={totals}
                cajeros={cajeros}
                usedTickets={usedTickets}
                addTransaction={addTransaction}
                updateTransaction={updateTransaction}
                setPersona={setPersona}
                deleteTransaction={deleteTransaction}
              />
            )}
            {tab === "resumen" && (
              <ResumenTab
                corte={corte}
                updateField={updateField}
                totals={totals}
                diferenciaPiezas={diferenciaPiezas}
                efectivoTotal={efectivoTotal}
                parcialesTotal={parcialesTotal}
                diferenciaFlujoEfectivo={diferenciaFlujoEfectivo}
                totalSaldos={totalSaldos}
                fondoFijo={fondoFijo}
                aperturaSiguienteDia={aperturaSiguienteDia}
                balanceado={balanceado}
                branchName={branchName}
                date={date}
              />
            )}
            {tab === "parciales" && (
              <ParcialesTab
                corte={corte}
                parcialesTotal={parcialesTotal}
                efectivoTotal={efectivoTotal}
                registrarParcial={registrarParcial}
              />
            )}
            {tab === "tablero" && (
              <TableroTab
                corte={corte}
                totals={totals}
                branchName={branchName}
                date={date}
                diferenciaPiezas={diferenciaPiezas}
                efectivoTotal={efectivoTotal}
                parcialesTotal={parcialesTotal}
                diferenciaFlujoEfectivo={diferenciaFlujoEfectivo}
                totalSaldos={totalSaldos}
                fondoFijo={fondoFijo}
                aperturaSiguienteDia={aperturaSiguienteDia}
              />
            )}
            {tab === "comparativo" && <ComparativoTab branches={branches} date={date} />}
            {tab === "cajeros" && (
              <CajerosTab cajeros={cajeros} addCajero={addCajero} toggleCajeroLock={toggleCajeroLock} deleteCajero={deleteCajero} />
            )}
            {tab === "historial" && (
              <HistorialTab
                branch={branch}
                branchName={branchName}
                currentDate={date}
                onSelectDate={(d) => {
                  setDate(d);
                  setTab("resumen");
                }}
              />
            )}
          </>
        )}
      </main>

      <footer className="foot">
        Los datos se guardan automáticamente y son visibles para cualquiera que use este mismo enlace.
      </footer>
    </div>
  );
}

/* ============================================================ TICKET INPUT (con validación de duplicados) */
function TicketInput({ value, otherTickets, onCommit }) {
  const [local, setLocal] = useState(value);
  const [warn, setWarn] = useState("");
  useEffect(() => setLocal(value), [value]);

  const commit = () => {
    const trimmed = local.trim();
    const dup = trimmed && otherTickets.some((t) => (t || "").trim().toUpperCase() === trimmed.toUpperCase());
    if (dup) {
      setWarn("Ese ticket ya existe, no se guardó");
      setLocal(value);
      setTimeout(() => setWarn(""), 2600);
      return;
    }
    onCommit(trimmed);
  };

  return (
    <div className="ticket-wrap">
      <input
        className="tx-inline ticket"
        value={local}
        onClick={(e) => e.stopPropagation()}
        onChange={(e) => setLocal(e.target.value)}
        onBlur={commit}
        placeholder="TVI…"
      />
      {warn && <span className="ticket-warn">{warn}</span>}
    </div>
  );
}

/* ============================================================ REGISTRAR VENTAS */
function RegistrarTab({ corte, totals, cajeros, usedTickets, addTransaction, updateTransaction, setPersona, deleteTransaction }) {
  const [openRow, setOpenRow] = useState(null);

  return (
    <div className="panel">
      <div className="panel-head">
        <div>
          <h2>Ventas del día</h2>
          <p className="muted">
            {totals.count} tickets · <b>{num(totals.pzas)} piezas</b> · {money(totals.grandTotal)} total
          </p>
        </div>
        <button className="primary-btn" onClick={addTransaction}>+ Nueva venta</button>
      </div>

      {corte.transactions.length === 0 ? (
        <div className="empty">Aún no hay ventas registradas hoy. Toca <b>+ Nueva venta</b> para capturar el primer ticket.</div>
      ) : (
        <div className="tx-list">
          {corte.transactions.map((row, i) => {
            const rowTotal = PAY_FIELDS.reduce((s, f) => s + (Number(row[f.key]) || 0), 0);
            const isOpen = openRow === row.id;
            const cajero = cajeros.find((c) => c.name === row.persona);
            const efectivoLocked = !!cajero?.efectivoBloqueado;
            const otherTickets = usedTickets.filter((_, idx) => corte.transactions[idx].id !== row.id);

            return (
              <div className={"tx-card" + (isOpen ? " open" : "")} key={row.id}>
                <div className="tx-row-summary" onClick={() => setOpenRow(isOpen ? null : row.id)}>
                  <span className="tx-no">{i + 1}</span>
                  <select
                    className="tx-inline persona-select"
                    value={row.persona}
                    onClick={(e) => e.stopPropagation()}
                    onChange={(e) => setPersona(row.id, e.target.value)}
                  >
                    <option value="">Cajero…</option>
                    {cajeros.map((c) => (
                      <option key={c.id} value={c.name}>
                        {c.name}{c.efectivoBloqueado ? " (sin efvo)" : ""}
                      </option>
                    ))}
                  </select>
                  <TicketInput
                    value={row.ticket}
                    otherTickets={otherTickets}
                    onCommit={(v) => updateTransaction(row.id, "ticket", v)}
                  />
                  <span className="tx-total">{money(rowTotal)}</span>
                  <button
                    className="icon-btn danger"
                    onClick={(e) => { e.stopPropagation(); deleteTransaction(row.id); }}
                    title="Eliminar"
                  >✕</button>
                  <span className="chevron">{isOpen ? "▲" : "▼"}</span>
                </div>

                {isOpen && (
                  <div className="tx-detail">
                    <div className="detail-group">
                      <h4>Piezas</h4>
                      <div className="grid3">
                        <Field label="Piezas" type="number" value={row.pzas} onChange={(v) => updateTransaction(row.id, "pzas", v)} />
                        <Field label="Envíos" type="number" value={row.envios} onChange={(v) => updateTransaction(row.id, "envios", v)} />
                      </div>
                    </div>

                    <div className="detail-group">
                      <h4>Desglose de pago</h4>
                      {efectivoLocked && (
                        <div className="lock-note">🔒 {row.persona} tiene el efectivo bloqueado para este corte.</div>
                      )}
                      <div className="grid3 money-grid">
                        {PAY_FIELDS.map((f) =>
                          f.key === "efectivo" ? (
                            <Field
                              key={f.key}
                              label={f.label}
                              type="number"
                              money
                              value={efectivoLocked ? "" : row.efectivo}
                              onChange={(v) => updateTransaction(row.id, f.key, v)}
                              disabled={efectivoLocked}
                            />
                          ) : (
                            <Field
                              key={f.key}
                              label={f.label}
                              type="number"
                              money
                              value={row[f.key]}
                              onChange={(v) => updateTransaction(row.id, f.key, v)}
                            />
                          )
                        )}
                      </div>
                      <div className="row-total-line">Total del ticket: <b>{money(rowTotal)}</b></div>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      {corte.transactions.length > 0 && (
        <div className="totals-bar">
          <span>Piezas: <b>{num(totals.pzas)}</b></span>
          <span>Envíos: <b>{num(totals.envios)}</b></span>
          {PAY_FIELDS.map((f) => (
            <span key={f.key}>{f.short}: <b>{money(totals.byMethod[f.key])}</b></span>
          ))}
          <span className="grand">Total: <b>{money(totals.grandTotal)}</b></span>
        </div>
      )}
    </div>
  );
}

function Field({ label, value, onChange, type = "text", money: isMoney, wide, disabled }) {
  return (
    <label className={"field" + (wide ? " wide" : "") + (disabled ? " disabled" : "")}>
      <span>{label}</span>
      <div className={"field-input" + (isMoney ? " money" : "")}>
        {isMoney && <span className="prefix">$</span>}
        <input
          type={type}
          inputMode={type === "number" ? "decimal" : undefined}
          value={value}
          disabled={disabled}
          onChange={(e) => onChange(e.target.value)}
          placeholder={isMoney ? "0.00" : ""}
        />
      </div>
    </label>
  );
}

/* ============================================================ RESUMEN */
function ResumenTab(props) {
  const { corte, updateField, totals, diferenciaPiezas, efectivoTotal, parcialesTotal, diferenciaFlujoEfectivo, totalSaldos, fondoFijo, aperturaSiguienteDia, balanceado, branchName, date } = props;

  return (
    <div className="panel">
      <div className="panel-head">
        <div>
          <h2>Resumen del día</h2>
          <p className="muted">{branchName} · {date}</p>
        </div>
        <div className={"balance-pill " + (balanceado ? "ok" : "off")}>
          {balanceado ? "Caja balanceada" : "Hay diferencia"}
        </div>
      </div>

      <div className="cards-grid">
        <div className="card">
          <div className="card-label">Total del día</div>
          <div className="card-value">{money(totals.grandTotal)}</div>
          <div className="card-sub">{totals.count} tickets</div>
        </div>
        <div className="card">
          <div className="card-label">Efectivo en caja</div>
          <div className="card-value">{money(efectivoTotal)}</div>
        </div>
        <div className="card">
          <div className="card-label">Apertura día siguiente</div>
          <div className="card-value">{money(aperturaSiguienteDia)}</div>
        </div>
      </div>

      <div className="two-col">
        <div className="block">
          <h3>Conciliación de piezas (SAP)</h3>
          <Field label="Piezas SAP" type="number" value={corte.piezasSAP} onChange={(v) => updateField("piezasSAP", v)} />
          <div className="kv"><span>Piezas por ticket</span><b>{num(totals.totalPzas)}</b></div>
          <div className={"kv " + (Math.abs(diferenciaPiezas) < 0.01 ? "good" : "bad")}>
            <span>Diferencia piezas</span><b>{num(diferenciaPiezas)}</b>
          </div>
        </div>

        <div className="block">
          <h3>Flujo de efectivo</h3>
          <div className="kv"><span>Parciales (Brinks)</span><b>{money(parcialesTotal)}</b></div>
          <div className="kv"><span>Efectivo (tickets)</span><b>{money(efectivoTotal)}</b></div>
          <div className={"kv " + (balanceado ? "good" : "bad")}>
            <span>Diferencia flujo efectivo</span><b>{money(diferenciaFlujoEfectivo)}</b>
          </div>
          <Field label="Saldo día anterior" type="number" money value={corte.saldoDiaAnterior} onChange={(v) => updateField("saldoDiaAnterior", v)} />
